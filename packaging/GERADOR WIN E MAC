# Execute no PowerShell:

.\packaging\windows\build_installer.ps1

# Ou passo a passo:

python packaging/windows/prepare_icon.py          # 1. Converter ícone

python packaging/build.py --platform windows      # 2. Build executável

# 3. Abra 'packaging/windows/SISTEMA_OPERA.iss' no Inno Setup

# 4. Clique em Compile (F9)




# Execute no terminal macOS:
chmod +x packaging/macos/build_installer.sh
./packaging/macos/build_installer.sh

# Sem perguntas (gera DMG + PKG automaticamente):
./packaging/macos/build_installer.sh --with-dmg --with-pkg

# Ou manualmente:
python packaging/build.py --platform macos
./packaging/macos/build_installer.sh
# Para instalador de dois cliques no macOS (PKG):
./packaging/macos/build_installer.sh   # escolha gerar PKG ao final
# Saída: dist/SistemaOpera.pkg

# O PKG abre janela única para configurar local/rede, host/porta, banco, usuário, senha e schema (com teste de conexão).

# O PKG instala também: /Applications/Desinstalar SistemaOpera.command (remove app + configs).
