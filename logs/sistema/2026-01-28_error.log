\n          AND table_name = 'cortes_finalizados' \n          AND column_name = 'retorno_id'\n    ) INTO col_exists;\n    \n    IF col_exists THEN\n        RAISE NOTICE '🔄 Adicionando coluna retorno_id...';\n        ALTER TABLE opera.cortes_finalizados \n        ADD COLUMN retorno_id INTEGER;\n        \n        \n        IF EXISTS (SELECT 1 FROM information_schema.tables \n                  WHERE table_schema = 'opera' AND table_name = 'controle_retorno_cortes') THEN\n            ALTER TABLE opera.cortes_finalizados \n            ADD CONSTRAINT fk_cortes_finalizados_retorno \n            FOREIGN KEY (retorno_id) REFERENCES opera.controle_retorno_cortes(id) ON DELETE SET NULL;\n            RAISE NOTICE '✅ Foreign Key para controle_retorno_cortes adicionada.';\n        END IF;\n        RAISE NOTICE '✅ Coluna retorno_id adicionada.';\n    ELSE\n        RAISE NOTICE 'ℹ️ Coluna retorno_id já existe.';\n    END IF;\n    \n    \n    SELECT NOT EXISTS (\n        SELECT 1 \n        FROM information_schema.columns \n        WHERE table_schema = 'opera' \n          AND table_name = 'cortes_finalizados' \n          AND column_name = 'tipo_servico'\n    ) INTO col_exists;\n    \n    IF col_exists THEN\n        RAISE NOTICE '🔄 Adicionando coluna tipo_servico...';\n        ALTER TABLE opera.cortes_finalizados \n        ADD COLUMN tipo_servico VARCHAR(100);\n        RAISE NOTICE '✅ Coluna tipo_servico adicionada.';\n    ELSE\n        RAISE NOTICE 'ℹ️ Coluna tipo_servico já existe.';\n    END IF;\n    \n    \n    SELECT NOT EXISTS (\n        SELECT 1 \n        FROM information_schema.columns \n        WHERE table_schema = 'opera' \n          AND table_name = 'cortes_finalizados' \n          AND column_name = 'valor_total'\n    ) INTO col_exists;\n    \n    IF col_exists THEN\n        RAISE NOTICE '🔄 Adicionando coluna valor_total...';\n        ALTER TABLE opera.cortes_finalizados \n        ADD COLUMN valor_total NUMERIC(12,2) DEFAULT 0.00;\n        RAISE NOTICE '✅ Coluna valor_total